<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Minha área • LNZ</title><link rel="stylesheet" href="/style.css"></head>
<body><div class="ambient"></div><header class="topbar"><a class="brand" href="/"><span class="brandmark">LNZ</span><span>Cliente</span></a><div class="userchip"><span><%= user.global_name || user.username %></span><a class="btn primary small" href="/sala">📺 Assistir</a><% if (isAdmin) { %><a class="btn ghost small" href="/dashboard">Admin</a><% } %><a class="btn ghost small" href="/logout">Sair</a></div></header>
<main class="shell client-shell"><div class="pagehead"><div><div class="eyebrow">ÁREA DO CLIENTE</div><h1>Olá, <%= user.global_name || user.username %> 👋</h1><p>Acompanhe seu serviço, vencimento e histórico.</p></div></div>
<% if (message) { %><div class="notice"><%= message %></div><% } %>
<% const d = daysUntil(client.dueDate); %>
<section class="service-card"><div><div class="eyebrow">SEU SERVIÇO</div><h2><%= client.plan %></h2><span class="badge <%= d < 0 ? 'red' : d <= 7 ? 'yellow' : 'green' %>"><%= d < 0 ? 'Hospedagem vencida' : 'Hospedagem ativa' %></span></div><div class="due"><span>Próximo vencimento</span><strong><%= formatDate(client.dueDate) %></strong><small><%= d < 0 ? Math.abs(d) + ' dias em atraso' : d === 0 ? 'vence hoje' : 'faltam ' + d + ' dias' %></small></div><div class="price"><span>Renovação atual</span><strong><%= brl(client.monthlyValue) %></strong><form method="post" action="/cliente/renovar"><button class="btn primary" type="submit">Renovar agora</button></form></div></section>
<section class="stats clientstats"><div class="stat"><span>Status</span><strong><%= d < 0 ? '🔴 Vencido' : '🟢 Online' %></strong><small>hospedagem</small></div><div class="stat"><span>Plano</span><strong class="smaller"><%= client.plan %></strong><small>serviço contratado</small></div><div class="stat"><span>Pagamentos</span><strong><%= client.payments?.length || 0 %></strong><small>renovações registradas</small></div><div class="stat"><span>Tickets</span><strong><%= tickets.length %></strong><small>atendimentos</small></div></section>
<section class="split"><div class="panel"><div class="panel-title"><div><h2>Histórico de compras</h2><p>Vendas ligadas ao seu Discord</p></div></div><div class="list"><% sales.forEach(s => { %><div class="listrow"><div><strong><%= s.product %></strong><small><%= new Date(s.createdAt).toLocaleDateString('pt-BR') %> • <%= s.paymentMethod %></small></div><div class="money"><%= brl(s.amount) %></div></div><% }) %><% if (!sales.length) { %><div class="empty">Ainda não há vendas registradas.</div><% } %></div></div>
<div class="panel"><div class="panel-title"><div><h2>Meus tickets</h2><p>Transcrições e atendimento</p></div></div><div class="list"><% tickets.forEach(t => { %><a class="listrow linkrow" href="/transcricao/<%= t.id %>"><div><strong>Ticket #<%= t.id %></strong><small><%= t.reason %></small></div><span class="badge <%= t.status === 'open' ? 'green' : '' %>"><%= t.status === 'open' ? 'Aberto' : 'Transcrição' %></span></a><% }) %><% if (!tickets.length) { %><div class="empty">Você ainda não abriu tickets.</div><% } %></div></div></section>
</main><footer>© 2026 LNZ Gestão</footer></body></html>
