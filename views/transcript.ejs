<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ticket #<%= ticket.id %> • LNZ</title><link rel="stylesheet" href="/style.css"></head><body><div class="ambient"></div><header class="topbar"><a class="brand" href="/"><span class="brandmark">LNZ</span><span>Transcrição</span></a><a class="btn ghost small" href="javascript:history.back()">Voltar</a></header><main class="shell narrow"><div class="pagehead"><div><div class="eyebrow">TRANSCRIÇÃO</div><h1>Ticket #<%= ticket.id %></h1><p><%= ticket.reason %></p></div><span class="badge"><%= ticket.status === 'open' ? 'Aberto' : 'Fechado' %></span></div><section class="panel chat"><% (ticket.transcript || []).forEach(m => { %><div class="msg"><div class="avatar"><%= (m.author || '?').slice(0,1).toUpperCase() %></div><div><div class="msghead"><strong><%= m.author %></strong><small><%= new Date(m.createdAt).toLocaleString('pt-BR') %></small></div><p><%= m.content %></p><% (m.attachments || []).forEach(a => { %><a href="<%= a %>" target="_blank" rel="noreferrer">Anexo</a><% }) %></div></div><% }) %><% if (!ticket.transcript?.length) { %><div class="empty">O ticket está aberto ou não possui mensagens salvas ainda.</div><% } %></section></main></body></html>
